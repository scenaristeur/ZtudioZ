    {
      "parameters": {
        "jsCode": "const j = $json && typeof $json === 'object' ? $json : {};\nconst src = (j.data && typeof j.data === 'object') ? j.data : j;\nconst decision = src.decision || 'continue';\nconst feedback = src.feedback || '';\nconsole.log('Décision:', decision, '| Feedback:', feedback);\nif (decision === 'skip' || decision === 'quit') {\n  throw new Error(\"Workflow arrêté par l'utilisateur (\" + decision + \")\");\n}\nreturn [{ json: { ...j, decision, feedback } }];"
      },
