    {
      "parameters": {
        "formTitle": "ZtudioZ — Lancement de production",
        "formDescription": "Lance la production d'une scène : parse → fiches → sheets → storyboard → visualize → keyframes/produce → audio, avec approbation humaine entre chaque étape.",
        "formFields": [
          {
            "fieldLabel": "Slug du projet",
            "fieldType": "string",
            "required": true,
            "placeholder": "ex: test_proj"
          },
          {
            "fieldLabel": "Numéro de scène",
            "fieldType": "number",
            "required": true,
            "defaultValue": 1
          }
        ],
        "options": {
          "respondMode": "respondInWebhook"
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 1,
      "position": [
        260,
        280
      ],
      "id": "bf70debe-fc6f-4b45-b1f2-673997aa1a2a",
      "name": "Form Lancement"
    },
    {
      "parameters": {
        "jsCode": "const DEFAULT_SLUG = 'test_proj';\nconst j = $json && typeof $json === 'object' ? $json : {};\nconst src = (j.data && typeof j.data === 'object') ? j.data : j;\nlet slug = String(src.slug || src.projectSlug || '').trim();\nif (!slug) slug = DEFAULT_SLUG;\nconst scene = Math.max(1, parseInt(src.scene, 10) || 1);\nconst scene_key = 'scene_' + String(scene).padStart(2, '0');\nconsole.log('Params:', slug, scene);\nreturn [{ json: { slug, scene, scene_key } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        140
      ],
