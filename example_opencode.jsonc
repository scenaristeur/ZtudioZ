{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pollinations": {
      "type": "local",
      "command": ["npx","@pollinations/mcp"],
      "env": {
        "POLLINATIONS_API_KEY": "sk_..."
      },
      "enabled": true,
    },
    "ztudioz": {
      "type": "local",
      "command": [".venv/bin/python", "run_mcp_server.py", "--mode", "stdio"],
      "env": {},
      "enabled": true,
    }
  }
}
