{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brief de production",
  "type": "object",
  "required": ["logline", "synopsis", "characters", "locations", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "logline": {"type": "string", "minLength": 1},
    "synopsis": {"type": "string", "minLength": 1},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "constraints": {
      "type": "object",
      "description": "Contraintes explicitement posees par l'auteur. Elles doivent survivre a chaque palier.",
      "additionalProperties": false,
      "properties": {
        "max_shots": {"type": "integer", "minimum": 1},
        "freeform": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
