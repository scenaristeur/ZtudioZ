{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict vision",
  "description": "Decision du controleur de continuite sur les images produites, plan par plan.",
  "type": "object",
  "required": ["ok", "notes"],
  "additionalProperties": false,
  "properties": {
    "ok": {"type": "boolean"},
    "notes": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string", "minLength": 1}}
      ]
    },
    "shots": {
      "type": "array",
      "description": "Un jugement par image de plan, dans l'ordre des plans recus (index 0-based).",
      "items": {
        "type": "object",
        "required": ["index", "ok", "notes"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "ok": {"type": "boolean"},
          "notes": {"type": "string", "minLength": 1},
          "issues": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "description": "Une entree par contrainte freeform du brief, jugee sur les images.",
      "items": {
        "type": "object",
        "required": ["text", "respected"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "respected": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["constraints"],
        "properties": {
          "constraints": {
            "contains": {
              "type": "object",
              "required": ["respected"],
              "properties": {"respected": {"const": false}}
            }
          }
        }
      },
      "then": {
        "properties": {"ok": {"const": false}}
      }
    },
    {
      "if": {
        "required": ["shots"],
        "properties": {
          "shots": {
            "contains": {
              "type": "object",
              "required": ["ok"],
              "properties": {"ok": {"const": false}}
            }
          }
        }
      },
      "then": {
        "properties": {"ok": {"const": false}}
      }
    }
  ]
}
