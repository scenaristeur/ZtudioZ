{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict vision",
  "description": "Decision du controleur de continuite sur les images produites.",
  "type": "object",
  "required": ["ok", "notes"],
  "additionalProperties": false,
  "properties": {
    "ok": {"type": "boolean"},
    "notes": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string", "minLength": 1}}
      ]
    }
  }
}
