"@context": "studio:context"
"@id": "studio:workflow/m2-keyframes"
type: studio:Workflow
name: Montage M2 avec keyframes
description: Palier M2 - des plans a deux images cles validees, puis de vraies videos debut/fin.
version: 1
inputs:
  plans:
    type: list
    required: true
nodes:
  - id: gate_storyboard
    type: studio:HumanGate
    question: Les fiches de plans (duree, mouvement, fin) sont-elles bonnes avant de generer les keyframes ?
    options: [continue, retry, stop]
  - id: keyframes
    agent: studio:agent/keyframe-maker
    foreach: "${plans}"
    parallel: 1
    on_item_failure: continue
    needs: [gate_storyboard]
  - id: gate_keyframes
    type: studio:HumanGate
    needs: [keyframes]
    question: Les images de debut et de fin tiennent-elles le plan avant de payer la video ?
    options: [continue, retry, stop]
  - id: clips
    agent: studio:agent/video-maker
    foreach: "${keyframes}"
    parallel: 1
    on_item_failure: continue
    needs: [keyframes, gate_keyframes]
  - id: gate_videos
    type: studio:HumanGate
    needs: [clips]
    question: Les videos generees tiennent-elles le plan ?
    options: [continue, retry, stop]
  - id: board
    agent: studio:agent/mounter
    needs: [clips, gate_videos]
  - id: gate_montage
    type: studio:HumanGate
    needs: [board]
    question: Le montage est-il conforme au decoupage ?
    options: [continue, retry, stop]
  - id: probe
    agent: studio:agent/prober
    needs: [board, gate_montage]
